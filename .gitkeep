 (cd "$(git rev-parse --show-toplevel)" && printf '%s' 'diff --git a/index.html b/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..d0555eac55290f1663a92126b3b4b189624c5b67
--- /dev/null
+++ b/index.html
@@ -0,0 +1,52 @@
+<!doctype html>
+<html lang="zh-Hant">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
+  <meta name="theme-color" content="#07111f" />
+  <title>台指期聰明錢雷達</title>
+  <style>
+    :root{--bg:#07111f;--panel:#0d1c2e;--line:#1d3851;--text:#e8f0f7;--muted:#8fa7bb;--up:#31d49a;--down:#ff6d7d;--accent:#67b7ff;--warn:#ffca62}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top right,#142f4a,transparent 38%),var(--bg);color:var(--text);font:14px/1.45 system-ui,-apple-system,"Noto Sans TC",sans-serif}.app{max-width:1480px;margin:auto;padding:18px}.top{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-bottom:16px}.brand{display:flex;gap:12px;align-items:center}.logo{width:42px;height:42px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,#2394ec,#7667ff);font-size:22px}.brand h1{font-size:20px;margin:0}.brand p{margin:0;color:var(--muted);font-size:12px}.pill{border:1px solid var(--line);border-radius:999px;padding:5px 10px;color:var(--muted);white-space:nowrap}.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--muted);margin-right:6px}.live .live-dot{background:var(--up);box-shadow:0 0 10px var(--up)}.grid{display:grid;gap:14px}.metrics{grid-template-columns:repeat(4,1fr)}.card{border:1px solid var(--line);background:linear-gradient(145deg,rgba(17,39,61,.96),rgba(9,25,42,.96));border-radius:16px;padding:15px;box-shadow:0 12px 32px #0002}.metric small,.section-title small{color:var(--muted)}.metric strong{display:block;font-size:24px;margin-top:5px;letter-spacing:-.5px}.up{color:var(--up)}.down{color:var(--down)}.main{grid-template-columns:1.5fr 1fr;margin-top:14px}.section-title{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:13px}.section-title h2{font-size:15px;margin:0}.signal{border-left:4px solid var(--warn)}.signal.buy{border-left-color:var(--up)}.signal.sell{border-left-color:var(--down)}.signal-name{font-size:24px;font-weight:750;margin:5px 0}.reason{color:var(--muted);margin:0}.confidence{height:8px;background:#183149;border-radius:8px;overflow:hidden;margin:13px 0 6px}.confidence i{display:block;height:100%;background:linear-gradient(90deg,#ffca62,#31d49a);border-radius:8px}.table-wrap{overflow:auto;max-height:390px}table{width:100%;border-collapse:collapse;white-space:nowrap}th,td{padding:10px 7px;text-align:right;border-bottom:1px solid #183149;font-variant-numeric:tabular-nums}th{position:sticky;top:0;background:#10243a;color:var(--muted);font-size:12px}th:first-child,td:first-child{text-align:left}.charts{grid-template-columns:1fr 1fr;margin-top:14px}.chart{height:200px;width:100%;display:block}.legend{display:flex;gap:12px;color:var(--muted);font-size:12px}.legend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px}.control{margin-top:14px}.form-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.field{display:grid;gap:4px;color:var(--muted);font-size:12px}.field.wide{grid-column:span 2}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;color:var(--text);background:#091827;border:1px solid var(--line);border-radius:9px;padding:9px}textarea{min-height:80px;resize:vertical}button{cursor:pointer;border:0;border-radius:9px;padding:10px 13px;background:#258de0;color:white;font-weight:650}button.secondary{background:#19334a;color:var(--text)}button.warn{background:#9d7120}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.hint{color:var(--muted);font-size:12px;margin:10px 0 0}.notice{margin-top:14px;padding:11px 13px;border-radius:10px;background:#152b3f;color:#b8c9d7;font-size:12px}.hidden{display:none}dialog{color:var(--text);background:#0d1c2e;border:1px solid var(--line);border-radius:16px;max-width:min(720px,94vw);padding:18px}dialog::backdrop{background:#000a}.status{font-size:12px;color:var(--muted)}@media(max-width:900px){.metrics{grid-template-columns:repeat(2,1fr)}.main,.charts{grid-template-columns:1fr}.form-grid{grid-template-columns:repeat(2,1fr)}.app{padding:12px}.top{align-items:flex-start}.metric strong{font-size:20px}}@media(max-width:500px){.top{flex-direction:column}.metrics{gap:9px}.card{padding:12px}.form-grid{grid-template-columns:1fr}.field.wide{grid-column:auto}.metric strong{font-size:18px}.brand h1{font-size:18px}}
+  </style>
+</head>
+<body><main class="app">
+  <header class="top"><div class="brand"><div class="logo">◈</div><div><h1>台指期聰明錢雷達</h1><p>即時成交分級 · 訊號僅供模擬與研究</p></div></div><div class="pill" id="connection"><span class="live-dot"></span>尚未連線</div></header>
+  <section class="grid metrics">
+    <article class="card metric"><small>最新價</small><strong id="lastPrice">--</strong><span id="priceChange" class="status">等待資料</span></article>
+    <article class="card metric"><small>大戶淨主動量</small><strong id="largeNet">--</strong><span class="status">大台等值口數</span></article>
+    <article class="card metric"><small>聰明錢指數</small><strong id="smartScore">--</strong><span class="status">-100（賣）至 +100（買）</span></article>
+    <article class="card metric"><small>模擬損益</small><strong id="pnl">--</strong><span id="position" class="status">目前：觀望</span></article>
+  </section>
+  <section class="grid main">
+    <article class="card signal" id="signalCard"><div class="section-title"><div><h2>交易判讀</h2><small id="updatedAt">尚無成交資料</small></div><span class="pill" id="marketState">等待中</span></div><div class="signal-name" id="signalName">觀望</div><p class="reason" id="signalReason">連線後將依大額主動買賣、連續性與價格動能計算。</p><div class="confidence"><i id="confidence" style="width:0%"></i></div><div class="status">訊號信心 <b id="confidenceText">0%</b> · 風控採 0.35% 停損 / 0.70% 停利（可在程式調整）</div></article>
+    <article class="card"><div class="section-title"><div><h2>部位分布（大台等值）</h2><small>依商品乘數正規化</small></div></div><canvas class="chart" id="barChart"></canvas><div class="legend"><span><i style="background:#31d49a"></i>主動買</span><span><i style="background:#ff6d7d"></i>主動賣</span></div></article>
+  </section>
+  <section class="grid charts"><article class="card"><div class="section-title"><div><h2>大戶淨主動量（最近 60 筆）</h2><small>大單：≥ 5 大台等值</small></div></div><canvas class="chart" id="flowChart"></canvas></article><article class="card"><div class="section-title"><div><h2>模擬交易紀錄</h2><small>不會送出真實委託</small></div><button class="secondary" id="resetSim">重置</button></div><div class="table-wrap"><table><thead><tr><th>時間</th><th>動作</th><th>價格</th><th>原因</th></tr></thead><tbody id="tradeLog"><tr><td colspan="4" class="status">尚無模擬成交</td></tr></tbody></table></div></article></section>
+  <section class="card control"><div class="section-title"><div><h2>資料與通知設定</h2><small>金鑰僅儲存在此瀏覽器 localStorage；正式部署建議使用自己的後端代理。</small></div><button class="secondary" id="openHelp">欄位說明</button></div>
+    <div class="form-grid"><label class="field wide">FinMind API 網址<input id="apiUrl" value="https://api.finmindtrade.com/api/v4/data" /></label><label class="field">商品代號<select id="symbol"><option value="TX">TX 大台</option><option value="MTX">MTX 小台</option><option value="TMF">TMF 微台</option></select></label><label class="field">輪詢秒數<input id="pollSeconds" type="number" min="3" value="10" /></label><label class="field wide">FinMind Token（付費帳號）<input id="token" type="password" autocomplete="off" placeholder="輸入後按儲存設定" /></label><label class="field">Telegram Bot Token<input id="telegramToken" type="password" autocomplete="off" placeholder="選填" /></label><label class="field">Telegram Chat ID<input id="telegramChat" placeholder="選填" /></label></div>
+    <div class="actions"><button id="saveSettings">儲存設定</button><button id="connect">開始即時追蹤</button><button class="secondary" id="stop">停止</button><button class="secondary" id="demo">載入示範資料</button><button class="warn" id="importBtn">貼上 / 匯入 JSON</button></div><p class="hint">預設請求格式：<code>?dataset=TaiwanFuturesTickData&data_id=TX&start_date=YYYY-MM-DD&token=...</code>。若您的付費方案欄位或端點不同，可在原始碼的 <code>normaliseTick</code> 對照修改。</p><div class="notice">風險提示：此工具以成交量、推定主動方向與固定門檻產生研究訊號，不代表「大戶」真實身分、未包含未平倉量與委託簿，亦非投資建議。請先以歷史資料回測並在模擬環境驗證。</div></section>
+</main>
+<dialog id="help"><h2>資料格式與安全說明</h2><p>可貼上 FinMind 回傳的 <code>{ data: [...] }</code> 或成交陣列。每筆至少需要時間、價格、數量；方向可用 <code>side</code>/<code>buy_sell</code>（買／賣、Buy／Sell、B／S）。沒有方向時，本頁以逐筆價格變化推定主動方。</p><p>支援常見欄位：<code>date/time/datetime</code>、<code>close/price</code>、<code>volume/qty</code>、<code>data_id/symbol</code>。小台以 0.25、大台以 1、微台以 0.05 換算為大台等值；請依契約規格自行複核。</p><button id="closeHelp">關閉</button></dialog>
+<dialog id="import"><h2>貼上成交 JSON</h2><textarea id="jsonInput" placeholder='\''[{"time":"09:00:01","price":22000,"volume":5,"side":"Buy","symbol":"TX"}]'\''></textarea><div class="actions"><button id="loadJson">載入並分析</button><button class="secondary" id="closeImport">取消</button></div></dialog>
+<script>
+(() => { '\''use strict'\'';
+  const $ = id => document.getElementById(id), state = {ticks:[], timer:null, seen:new Set(), sim:{position:0,entry:0,pnl:0,log:[]}, lastSignal:'\''觀望'\'', lastAlert:0};
+  const multipliers = {TX:1, MTX:.25, TMF:.05};
+  const num = x => Number(String(x ?? 0).replaceAll('\'','\'','\'''\'')) || 0;
+  const fmt = n => new Intl.NumberFormat('\''zh-TW'\'',{maximumFractionDigits:2,signDisplay:'\''exceptZero'\''}).format(n);
+  function normaliseTick(row) { const symbol = String(row.symbol ?? row.data_id ?? row.contract ?? $('\''symbol'\'').value).toUpperCase(); return { time:String(row.datetime ?? row.date ?? row.time ?? row.timestamp ?? new Date().toISOString()), price:num(row.price ?? row.close ?? row.deal_price ?? row.last_price), volume:num(row.volume ?? row.qty ?? row.quantity ?? row.trade_volume ?? 1), side:String(row.side ?? row.buy_sell ?? row.direction ?? '\'''\''), symbol }; }
+  function sideOf(t, prev) { const s=t.side.toLowerCase(); if (/buy|買|b$|long/.test(s)) return 1; if (/sell|賣|s$|short/.test(s)) return -1; return !prev ? 0 : Math.sign(t.price-prev.price); }
+  function ingest(rows) { let prev=state.ticks.at(-1); for(const raw of rows){const t=normaliseTick(raw), key=[t.time,t.price,t.volume,t.symbol,t.side].join('\''|'\''); if(!t.price||state.seen.has(key))continue; t.dir=sideOf(t,prev); t.eq=t.volume*(multipliers[t.symbol] ?? 1); t.large=t.eq>=5; state.ticks.push(t);state.seen.add(key);prev=t;} state.ticks=state.ticks.slice(-600); render(); }
+  function analysis() { const a=state.ticks.slice(-60), last=a.at(-1), prior=a.at(-16); if(!last)return null; const large=a.filter(x=>x.large), buy=large.filter(x=>x.dir>0).reduce((s,x)=>s+x.eq,0), sell=large.filter(x=>x.dir<0).reduce((s,x)=>s+x.eq,0), net=buy-sell, total=buy+sell, flow=total?net/total:0, move=prior?(last.price-prior.price)/prior.price:0, streak=a.slice(-8).reduce((s,x)=>s+x.dir,0)/8, score=Math.max(-100,Math.min(100,Math.round(flow*65+move*20000+streak*20))); let signal='\''觀望'\'', confidence=Math.min(95,Math.round(Math.abs(score)*.9)); if(score>=35&&net>=5)signal='\''偏多跟隨'\''; if(score<=-35&&net<=-5)signal='\''偏空跟隨'\''; return {last,prior,buy,sell,net,score,signal,confidence,move,large}; }
+  function simulate(x){ if(!x)return; const desired=x.signal==='\''偏多跟隨'\''?1:x.signal==='\''偏空跟隨'\''?-1:0, s=state.sim; const stop=s.position&&((s.position>0&&x.last.price<=s.entry*.9965)||(s.position<0&&x.last.price>=s.entry*1.0035)), take=s.position&&((s.position>0&&x.last.price>=s.entry*1.007)||(s.position<0&&x.last.price<=s.entry*.993)); if(s.position&&(desired!==s.position||stop||take)){const gain=(x.last.price-s.entry)*s.position;s.pnl+=gain;s.log.unshift([x.last.time.slice(11,19)||x.last.time,s.position>0?'\''平多'\'':'\''平空'\'',x.last.price,stop?'\''停損'\'':take?'\''停利'\'':'\''訊號反轉'\'']);s.position=0;} if(!s.position&&desired){s.position=desired;s.entry=x.last.price;s.log.unshift([x.last.time.slice(11,19)||x.last.time,desired>0?'\''模擬買進'\'':'\''模擬賣出'\'',x.last.price,'\''訊號確認'\'']);} s.log=s.log.slice(0,30); }
+  function render(){ const x=analysis(); if(!x)return; simulate(x); const signed=x.move*100; $('\''lastPrice'\'').textContent=fmt(x.last.price); $('\''priceChange'\'').textContent=`${fmt(signed)}%（近 15 筆）`; $('\''priceChange'\'').className=signed>=0?'\''status up'\'':'\''status down'\''; $('\''largeNet'\'').textContent=fmt(x.net); $('\''largeNet'\'').className=x.net>=0?'\''up'\'':'\''down'\''; $('\''smartScore'\'').textContent=fmt(x.score); $('\''smartScore'\'').className=x.score>=0?'\''up'\'':'\''down'\''; $('\''pnl'\'').textContent=fmt(state.sim.pnl); $('\''pnl'\'').className=state.sim.pnl>=0?'\''up'\'':'\''down'\''; $('\''position'\'').textContent='\''目前：'\''+(state.sim.position>0?'\''模擬多單'\'':state.sim.position<0?'\''模擬空單'\'':'\''觀望'\''); $('\''updatedAt'\'').textContent='\''最後成交：'\''+x.last.time; $('\''signalName'\'').textContent=x.signal; $('\''signalReason'\'').textContent=`大單主動買 ${fmt(x.buy)} ／ 賣 ${fmt(x.sell)}，淨量 ${fmt(x.net)}；價格動能 ${fmt(signed)}%。`; $('\''confidence'\'').style.width=x.confidence+'\''%'\'';$('\''confidenceText'\'').textContent=x.confidence+'\''%'\''; $('\''marketState'\'').textContent=x.large.length?'\''資料分析中'\'':'\''無大單'\''; $('\''signalCard'\'').className='\''card signal '\''+(x.signal==='\''偏多跟隨'\''?'\''buy'\'':x.signal==='\''偏空跟隨'\''?'\''sell'\'':'\'''\''); $('\''tradeLog'\'').innerHTML=state.sim.log.length?state.sim.log.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td><td>${fmt(r[2])}</td><td>${r[3]}</td></tr>`).join('\'''\''):'\''<tr><td colspan="4" class="status">尚無模擬成交</td></tr>'\''; drawBars(x);drawFlow(); if(x.signal!==state.lastSignal&&x.signal!=='\''觀望'\''){state.lastSignal=x.signal; telegram(x);} }
+  function canvas(id){const c=$(id),r=c.getBoundingClientRect(),d=devicePixelRatio;c.width=r.width*d;c.height=r.height*d;const x=c.getContext('\''2d'\'');x.scale(d,d);return [x,r.width,r.height]}
+  function drawBars(x){const [c,w,h]=canvas('\''barChart'\'');c.clearRect(0,0,w,h);const max=Math.max(x.buy,x.sell,1), data=[['\''主動買'\'',x.buy,'\''#31d49a'\''],['\''主動賣'\'',x.sell,'\''#ff6d7d'\'']];data.forEach((d,i)=>{const y=35+i*70;c.fillStyle='\''#173149'\'';c.fillRect(80,y,w-105,28);c.fillStyle=d[2];c.fillRect(80,y,(w-105)*d[1]/max,28);c.fillStyle='\''#b8c9d7'\'';c.font='\''12px system-ui'\'';c.fillText(d[0],4,y+18);c.fillText(fmt(d[1]),85,y+49);});}
+  function drawFlow(){const [c,w,h]=canvas('\''flowChart'\''), a=state.ticks.slice(-60);c.clearRect(0,0,w,h);c.strokeStyle='\''#1d3851'\'';c.beginPath();c.moveTo(0,h/2);c.lineTo(w,h/2);c.stroke();if(!a.length)return;let sum=0,pts=a.map(t=>{sum+=(t.large?t.dir*t.eq:0);return sum}),max=Math.max(...pts.map(Math.abs),1);c.strokeStyle='\''#67b7ff'\'';c.lineWidth=2;c.beginPath();pts.forEach((v,i)=>{let px=i*w/(pts.length-1||1),py=h/2-v/max*(h*.4);i?c.lineTo(px,py):c.moveTo(px,py)});c.stroke();}
+  async function poll(){ try {const u=new URL($('\''apiUrl'\'').value);u.searchParams.set('\''dataset'\'','\''TaiwanFuturesTickData'\'');u.searchParams.set('\''data_id'\'',$('\''symbol'\'').value);u.searchParams.set('\''start_date'\'',new Date().toISOString().slice(0,10));if($('\''token'\'').value)u.searchParams.set('\''token'\'',$('\''token'\'').value);const res=await fetch(u);if(!res.ok)throw Error('\''HTTP '\''+res.status);const json=await res.json();ingest(json.data ?? json);$('\''connection'\'').className='\''pill live'\'';$('\''connection'\'').innerHTML='\''<span class="live-dot"></span>即時追蹤中'\'';}catch(e){$('\''connection'\'').className='\''pill'\'';$('\''connection'\'').innerHTML='\''<span class="live-dot"></span>連線失敗：'\''+e.message;} }
+  async function telegram(x){const token=$('\''telegramToken'\'').value,chat=$('\''telegramChat'\'').value;if(!token||!chat||Date.now()-state.lastAlert<60000)return;state.lastAlert=Date.now();const msg=`台指期雷達：${x.signal}\n價格 ${x.last.price}\n大戶淨主動量 ${fmt(x.net)} 大台等值\n信心 ${x.confidence}%\n（模擬研究訊號，非投資建議）`;try{await fetch(`https://api.telegram.org/bot${token}/sendMessage`,{method:'\''POST'\'',headers:{'\''Content-Type'\'':'\''application/json'\''},body:JSON.stringify({chat_id:chat,text:msg})});}catch(e){console.warn('\''Telegram 發送失敗'\'',e)} }
+  function demo(){state.ticks=[];state.seen.clear();let p=22000, rows=[];for(let i=0;i<100;i++){const bullish=i>45;p+=(Math.random()-.42)*(bullish?7:4);rows.push({time:new Date(Date.now()-(100-i)*1000).toISOString(),price:p,volume:Math.ceil(Math.random()*8)+(bullish&&i%3===0?8:0),side:bullish?'\''Buy'\'':i%2?'\''Sell'\'':'\''Buy'\'',symbol:i%5?'\''TX'\'':'\''MTX'\''});}ingest(rows);}
+  function save(){['\''apiUrl'\'','\''symbol'\'','\''pollSeconds'\'','\''token'\'','\''telegramToken'\'','\''telegramChat'\''].forEach(k=>localStorage.setItem('\''radar_'\''+k,$(k).value));alert('\''已儲存於本機瀏覽器。'\'');} ['\''apiUrl'\'','\''symbol'\'','\''pollSeconds'\'','\''token'\'','\''telegramToken'\'','\''telegramChat'\''].forEach(k=>{const v=localStorage.getItem('\''radar_'\''+k);if(v!==null)$(k).value=v});
+  $('\''connect'\'').onclick=()=>{clearInterval(state.timer);poll();state.timer=setInterval(poll,Math.max(3,num($('\''pollSeconds'\'').value))*1000)};$('\''stop'\'').onclick=()=>{clearInterval(state.timer);state.timer=null;$('\''connection'\'').className='\''pill'\'';$('\''connection'\'').innerHTML='\''<span class="live-dot"></span>已停止'\''};$('\''demo'\'').onclick=demo;$('\''saveSettings'\'').onclick=save;$('\''openHelp'\'').onclick=()=>$('\''help'\'').showModal();$('\''closeHelp'\'').onclick=()=>$('\''help'\'').close();$('\''importBtn'\'').onclick=()=>$('\''import'\'').showModal();$('\''closeImport'\'').onclick=()=>$('\''import'\'').close();$('\''loadJson'\'').onclick=()=>{try{const data=JSON.parse($('\''jsonInput'\'').value);ingest(data.data??data);$('\''import'\'').close()}catch(e){alert('\''JSON 格式錯誤：'\''+e.message)}};$('\''resetSim'\'').onclick=()=>{state.sim={position:0,entry:0,pnl:0,log:[]};render()};window.addEventListener('\''resize'\'',()=>{if(state.ticks.length)render()});
+})();
+</script></body></html>
' | git apply --3way)
